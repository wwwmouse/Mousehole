# ---- 数据库（Docker Compose 提供 PostgreSQL）----
POSTGRES_USER=mousehole
POSTGRES_PASSWORD=mousehole
POSTGRES_DB=mousehole
POSTGRES_PORT=5433
DATABASE_URL=postgresql+pg8000://mousehole:mousehole@localhost:5433/mousehole

# ---- Docker 生产模式端口（前端）----
MOUSEHOLE_HTTP_PORT=8090

# ---- 应用 ----
APP_NAME=mousehole
DEFAULT_WORKSPACE_NAME=My Workspace
MAX_UPLOAD_MB=50

# ---- 本地数据目录（相对仓库根目录；不入 Git）----
STORAGE_DIR=../storage
DATA_DIR=../data

# ---- 模型 Provider（Phase 2 使用；密钥不入 Git）----
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# Docker 模式使用 host.docker.internal；本机直接运行 backend 时改成 http://127.0.0.1:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ---- OCR（Phase 6）----
# 脚本在宿主机运行用 127.0.0.1；Docker 后端内用 host.docker.internal
OCR_VLM_BASE_URL=http://127.0.0.1:11434/v1
OCR_VLM_MODEL=qwen3-vl:4b
OCR_VLM_API_KEY=ollama
OCR_VLM_TIMEOUT_SECONDS=180

# ---- 运行参数（Phase 5，可选覆盖）----
LOG_LEVEL=INFO
MAX_CONCURRENCY=2
CHAT_HISTORY_LIMIT=80
PARSE_TIMEOUT_SECONDS=120
DEFAULT_CONTEXT_BUDGET_TOKENS=32768
# 模型窗口表，JSON；键为 provider/model（Docker 模式需在 docker-compose backend environment 中显式添加）
# MODEL_CONTEXT_WINDOWS={"deepseek/deepseek-flash":1000000,"openai/gpt-4o":128000}

# ---- 测试（Postgres 集成测试专用库；切勿指向开发库）----
# TEST_DATABASE_URL=postgresql+pg8000://mousehole:mousehole@localhost:5433/mousehole_test
