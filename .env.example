# ---- 数据库（Docker Compose 提供 PostgreSQL）----
POSTGRES_USER=mousehole
POSTGRES_PASSWORD=mousehole
POSTGRES_DB=mousehole
POSTGRES_PORT=5433
DATABASE_URL=postgresql+pg8000://mousehole:mousehole@localhost:5433/mousehole

# ---- 应用 ----
APP_NAME=mousehole
DEFAULT_WORKSPACE_NAME=My Workspace
MAX_UPLOAD_MB=25

# ---- 本地数据目录（相对仓库根目录；不入 Git）----
STORAGE_DIR=../storage
DATA_DIR=../data

# ---- 模型 Provider（Phase 2 使用；密钥不入 Git）----
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
