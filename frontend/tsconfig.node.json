{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "allowJs": true,
    "strict": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "vite.config.mjs",
    "scripts/**/*.mjs"
  ]
}
